# Template only. Never place real secrets here.
DATABASE_URL=
REDIS_URL=
AI_PROVIDER_API_KEY=
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
PAPER_TRADING_ONLY=true
INITIAL_PAPER_CAPITAL=10000
MARKET_SYMBOL=btcusdt

# Separate simulated evaluation wallets; never subtracted from fund equity.
PAPER_EVALUATION_ENABLED=false
# Required, positive and explicit only when evaluation is enabled.
EVALUATION_PAPER_CAPITAL=

# New USD-M evaluation wallets are separate from existing legacy wallets and fund.
PERPETUAL_PAPER_ENABLED=false
AUTONOMOUS_PERPETUAL_ENABLED=false
# Required explicit completed/screened V2 study for autonomous evaluation.
AUTONOMOUS_STUDY_ID=
# Production only: configure through cloud secret manager, never commit a real value.
APP_ACCESS_TOKEN=
PUBLIC_ORIGIN=
NODE_ENV=development

# Legacy manual execution is retained only as an explicit compatibility option.
LEGACY_PAPER_EXECUTION_ENABLED=false

# Proxies de confiança entre o cliente e o app (para o IP do cliente no bloqueio de login).
# Vazio: 2 no Render (Cloudflare + balanceador) e 0 fora dele. Só preencha para corrigir o número.
TRUSTED_PROXY_HOPS=
