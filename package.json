{
  "name": "trading-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsc",
    "start:cloud": "node dist/src/launch-cloud.js",
    "import-state": "tsx src/import-state.ts",
    "check:cloud-config": "node dist/src/check-cloud-config.js",
    "check:cloud-service": "node dist/src/check-cloud-service.js",
    "decrypt-backup": "tsx src/decrypt-backup.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "pg": "^8.23.1",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
